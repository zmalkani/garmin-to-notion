# ============================================
# Garmin to Notion - Configuration
# ============================================
# Copy this file to .env and fill in your values.
# See README.md for setup instructions.

# --- Required for syncs ---
GARMIN_TOKENS=base64-token-bundle-from-generate_tokens-or-browser_login
NOTION_TOKEN=ntn_your_token_here

# --- Local-only: used only to generate/refresh GARMIN_TOKENS ---
# GARMIN_EMAIL=your@email.com
# GARMIN_PASSWORD=your-garmin-password

# --- Optional: Database IDs (auto-discovered if not set) ---
# NOTION_DB_ID=
# NOTION_PR_DB_ID=
# NOTION_STEPS_DB_ID=
# NOTION_SLEEP_DB_ID=
# NOTION_WORKOUTS_DB_ID=
# NOTION_SUMMARY_DB_ID=

# --- Optional: Settings ---
# TIMEZONE=UTC
# GARMIN_DAYS_BACK=30
# GARMIN_ACTIVITIES_FETCH_LIMIT=1000
